# Build environment for the Red Hat family (Fedora).
FROM fedora:latest
RUN dnf install -y gcc pkgconf-pkg-config gtk4-devel gtk4-layer-shell-devel dbus-devel rpm-build curl \
 && dnf clean all
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH=/root/.cargo/bin:$PATH
RUN cargo install cargo-generate-rpm
WORKDIR /src
